{
  "name": "autoflow",
  "version": "1.0.0",
  "description": "Smart connectors for Figma Design: FigJam-style flow arrows that stay attached to your screens and layers.",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/extract-icons.mjs",
    "build": "tsc --noEmit && tsc -p ui --noEmit && node scripts/build.mjs && node scripts/build-ui.mjs",
    "build:code": "node scripts/build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "listing": "npm run build && node scripts/render-listing.mjs",
    "release": "npm run check && node scripts/check-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "chroma-js": "3.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@create-figma-plugin/ui": "4.0.3",
    "@eslint/js": "10.0.1",
    "@figma/plugin-typings": "^1.142.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.0"
  }
}
