{
  "name": "autoflow",
  "version": "1.0.0",
  "description": "Smart connectors for Figma Design: FigJam-style flow arrows that stay attached to your screens and layers.",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/extract-icons.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "build:code": "node scripts/build.mjs",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "listing": "npm run build && node scripts/render-listing.mjs",
    "release": "npm run check && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@create-figma-plugin/ui": "4.0.3",
    "@eslint/js": "10.0.1",
    "@figma/plugin-typings": "^1.142.0",
    "@rogieking/figui3": "11.2.2",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
